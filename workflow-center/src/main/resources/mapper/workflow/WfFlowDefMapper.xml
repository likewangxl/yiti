<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bank.branch.platform.workflow.mapper.WfFlowDefMapper">

    <!-- WF_FLOW_DEF 全列查询片段 -->
    <sql id="BASE_COLUMNS">
        id, flow_key, biz_type, name, description, status, version,
        deployed_proc_def_key, deployed_proc_def_id, source_proc_def_key,
        is_readonly_import, created_time, created_by, updated_time, updated_by
    </sql>

    <!-- 根据流程唯一标识键查询流程定义 -->
    <select id="selectByFlowKey" resultType="com.bank.branch.platform.workflow.entity.WfFlowDef">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM WF_FLOW_DEF
        WHERE flow_key = #{flowKey}
    </select>

    <!-- selectById / insert / updateById / deleteById 由 MyBatis-Plus BaseMapper 提供 -->

</mapper>
