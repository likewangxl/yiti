<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bank.branch.platform.workflow.mapper.NodeCandidateConfMapper">

    <!-- WF_NODE_CANDIDATE_CONF 全列查询片段 -->
    <sql id="BASE_COLUMNS">
        id, process_definition_key, node_key,
        candidate_type, candidate_value,
        created_time, updated_time
    </sql>

    <!-- 根据流程定义KEY和节点KEY查询所有候选人配置 -->
    <select id="selectByProcessDefKeyAndNodeKey"
            resultType="com.bank.branch.platform.workflow.entity.WfNodeCandidateConf">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM WF_NODE_CANDIDATE_CONF
        WHERE process_definition_key = #{processDefinitionKey}
          AND node_key = #{nodeKey}
    </select>

    <!-- 根据流程定义KEY查询所有节点的候选人配置 -->
    <select id="selectByProcessDefKey" parameterType="string"
            resultType="com.bank.branch.platform.workflow.entity.WfNodeCandidateConf">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM WF_NODE_CANDIDATE_CONF
        WHERE process_definition_key = #{processDefinitionKey}
    </select>

    <!-- 根据流程定义KEY删除该流程的全部候选人配置（发布时先删后插） -->
    <delete id="deleteByProcessDefinitionKey" parameterType="string">
        DELETE FROM WF_NODE_CANDIDATE_CONF
        WHERE process_definition_key = #{processDefinitionKey}
    </delete>

    <!-- selectById / insert / updateById / deleteById 由 MyBatis-Plus BaseMapper 提供 -->

</mapper>
