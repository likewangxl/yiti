<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bank.branch.platform.workflow.mapper.TimeoutRuleMapper">

    <!-- WF_TIMEOUT_RULE 全列查询片段 -->
    <sql id="BASE_COLUMNS">
        id, process_definition_key, node_key,
        timeout_hours, warning_hours,
        created_time, updated_time
    </sql>

    <!-- 根据流程定义KEY和节点KEY查询超时规则 -->
    <select id="selectByProcessDefKeyAndNodeKey"
            resultType="com.bank.branch.platform.workflow.entity.WfTimeoutRule">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM WF_TIMEOUT_RULE
        WHERE process_definition_key = #{processDefinitionKey}
          AND node_key = #{nodeKey}
        LIMIT 1
    </select>

    <!-- 根据流程定义KEY查询所有节点的超时规则 -->
    <select id="selectByProcessDefKey"
            resultType="com.bank.branch.platform.workflow.entity.WfTimeoutRule">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM WF_TIMEOUT_RULE
        WHERE process_definition_key = #{processDefinitionKey}
    </select>

    <!-- selectById / insert / updateById 由 MyBatis-Plus BaseMapper 提供 -->

</mapper>
