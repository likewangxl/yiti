<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bank.branch.platform.workflow.mapper.BizProcessMapMapper">

    <!-- BIZ_PROCESS_MAP 全列查询片段 -->
    <sql id="BASE_COLUMNS">
        id, business_key, biz_type, biz_id,
        process_definition_key, process_instance_id,
        start_user, current_assignee, candidate_groups,
        process_status, title, start_time, end_time,
        created_time, updated_time
    </sql>

    <!-- selectById 由 MyBatis-Plus BaseMapper 提供 -->

    <!-- 根据业务键查询最新的非取消状态记录 -->
    <select id="selectByBusinessKey" parameterType="string"
            resultType="com.bank.branch.platform.workflow.entity.BizProcessMap">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM BIZ_PROCESS_MAP
        WHERE business_key = #{businessKey}
          AND process_status != 'CANCELLED'
        ORDER BY created_time DESC
        LIMIT 1
    </select>

    <!-- 根据流程实例ID查询 -->
    <select id="selectByProcessInstanceId" parameterType="string"
            resultType="com.bank.branch.platform.workflow.entity.BizProcessMap">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM BIZ_PROCESS_MAP
        WHERE process_instance_id = #{processInstanceId}
    </select>

    <!-- 根据业务类型和业务ID查询 -->
    <select id="selectByBizTypeAndBizId"
            resultType="com.bank.branch.platform.workflow.entity.BizProcessMap">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM BIZ_PROCESS_MAP
        WHERE biz_type = #{bizType}
          AND biz_id = #{bizId}
        ORDER BY created_time DESC
        LIMIT 1
    </select>

    <!-- insert / updateById 由 MyBatis-Plus BaseMapper 提供 -->

    <!-- 判断指定业务键是否存在运行中的流程 -->
    <select id="existsRunningByBusinessKey" parameterType="string" resultType="boolean">
        SELECT COUNT(*) > 0
        FROM BIZ_PROCESS_MAP
        WHERE business_key = #{businessKey}
          AND process_status = 'RUNNING'
    </select>

    <!-- 按 processInstanceId 列表 + bizType 批量查询（避免 N+1） -->
    <select id="selectByProcessInstanceIdsAndBizType"
            resultType="com.bank.branch.platform.workflow.entity.BizProcessMap">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM BIZ_PROCESS_MAP
        WHERE biz_type = #{bizType}
          AND process_instance_id IN
        <foreach collection="processInstanceIds" item="piid" open="(" separator="," close=")">
            #{piid}
        </foreach>
    </select>

    <!-- 审批流监控查询公共 WHERE：orgScope==null 表示全行不过滤；非 null 走 EXISTS(WF_PROCESS_ORG) -->
    <sql id="MONITOR_WHERE">
        <where>
            <if test="status != null and status != ''"> AND m.process_status = #{status} </if>
            <if test="bizType != null and bizType != ''"> AND m.biz_type = #{bizType} </if>
            <if test="startedBy != null and startedBy != ''"> AND m.start_user = #{startedBy} </if>
            <if test="keyword != null and keyword != ''"> AND m.title LIKE CONCAT('%', #{keyword}, '%') </if>
            <if test="orgScope != null">
                AND EXISTS (SELECT 1 FROM WF_PROCESS_ORG wpo
                            WHERE wpo.process_instance_id = m.process_instance_id
                              AND wpo.org_code IN
                            <foreach collection="orgScope" item="oc" open="(" separator="," close=")">#{oc}</foreach>)
            </if>
        </where>
    </sql>

    <!-- 审批流监控分页查询（调用方保证 orgScope 非 null 时一定非空，避免 IN () 语法错） -->
    <select id="selectMonitorPage" resultType="com.bank.branch.platform.workflow.entity.BizProcessMap">
        SELECT <include refid="BASE_COLUMNS"/> FROM BIZ_PROCESS_MAP m
        <include refid="MONITOR_WHERE"/>
        ORDER BY m.start_time DESC LIMIT #{offset}, #{size}
    </select>

    <!-- 审批流监控计数（条件与 selectMonitorPage 一致） -->
    <select id="countMonitor" resultType="long">
        SELECT COUNT(*) FROM BIZ_PROCESS_MAP m <include refid="MONITOR_WHERE"/>
    </select>

</mapper>
