<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bank.branch.platform.auth.mapper.RoleResourceMapper">

    <!-- 查询指定角色的已授权资源ID列表，用于权限缓存和授权页面回显 -->
    <select id="selectResourceIdsByRoleId" parameterType="string" resultType="string">
        SELECT RESOURCE_ID
        FROM PT_ROLE_RESOURCE
        WHERE ROLE_ID = #{roleId}
    </select>

    <!-- insert 由 MyBatis-Plus BaseMapper 提供，此处不再重复定义 -->

    <!--
        删除指定角色的全部资源授权。
        重新授权时先调用此方法清空旧记录，再批量 insert 新授权，
        确保授权操作的原子性（配合 @Transactional 使用）。
    -->
    <delete id="deleteByRoleId" parameterType="string">
        DELETE FROM PT_ROLE_RESOURCE
        WHERE ROLE_ID = #{roleId}
    </delete>

    <!--
        删除指定资源的全部角色授权。
        当资源下线（STATUS 改为 1）或物理删除时，需先清理此表中的关联记录，
        避免脏数据影响权限缓存。
    -->
    <delete id="deleteByResourceId" parameterType="string">
        DELETE FROM PT_ROLE_RESOURCE
        WHERE RESOURCE_ID = #{resourceId}
    </delete>

    <!--
        判断角色与资源的授权关系是否存在。
        使用 COUNT(*) > 0 的写法，MyBatis 能将数值型结果自动映射到 boolean。
        返回 1（true）表示已存在，0（false）表示不存在。
    -->
    <select id="existsByRoleIdAndResourceId" resultType="boolean">
        SELECT COUNT(*) > 0
        FROM PT_ROLE_RESOURCE
        WHERE ROLE_ID    = #{roleId}
          AND RESOURCE_ID = #{resourceId}
    </select>

    <!--
        查询指定角色已绑定的菜单资源 ID（仅 PT_RESOURCE.IS_MENU=1 部分）。
        JOIN PT_RESOURCE 过滤 ISMENU=1。用于"分配菜单"对话框回显勾选状态。
    -->
    <select id="selectMenuIdsByRoleId" parameterType="string" resultType="string">
        SELECT rr.RESOURCE_ID
        FROM PT_ROLE_RESOURCE rr
        INNER JOIN PT_RESOURCE r ON rr.RESOURCE_ID = r.RESOURCE_ID
        WHERE rr.ROLE_ID = #{roleId}
          AND r.ISMENU   = 1
    </select>

    <!--
        删除指定角色的"菜单"绑定（仅 IS_MENU=1 部分），保留接口绑定不动。
        与 deleteByRoleId 区分：deleteByRoleId 是全量清空（含接口和菜单）。
        用 IN 子查询定位需删除的 RESOURCE_ID，依赖 PT_RESOURCE.ISMENU 标识。
    -->
    <delete id="deleteMenuBindingsByRoleId" parameterType="string">
        DELETE FROM PT_ROLE_RESOURCE
        WHERE ROLE_ID = #{roleId}
          AND RESOURCE_ID IN (
              SELECT RESOURCE_ID FROM PT_RESOURCE WHERE ISMENU = 1
          )
    </delete>

    <!--
        删除指定角色的"接口"绑定（仅 ISMENU=0 部分）。
        配合 replaceMenus 联动：分菜单时先清接口绑定，再按新菜单+公共接口重建。
        MySQL 不支持在子查询里引用要删除的表，但 PT_ROLE_RESOURCE 和子查询的 PT_RESOURCE 是不同表，OK。
    -->
    <delete id="deleteInterfaceBindingsByRoleId" parameterType="string">
        DELETE FROM PT_ROLE_RESOURCE
        WHERE ROLE_ID = #{roleId}
          AND RESOURCE_ID IN (
              SELECT RESOURCE_ID FROM PT_RESOURCE WHERE ISMENU = 0
          )
    </delete>

</mapper>
