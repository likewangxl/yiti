<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bank.branch.platform</groupId>
        <artifactId>branch-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>soap-gateway-center</artifactId>
    <name>SOAP Gateway Center</name>
    <description>SOAP 服务接收网关：基于 Netty 独立端口接收外部 SOAP/XML 请求</description>

    <dependencies>
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Common 模块 -->
        <dependency>
            <groupId>com.bank.branch.platform</groupId>
            <artifactId>common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bank.branch.platform</groupId>
            <artifactId>common-trace</artifactId>
        </dependency>

        <!--
            performance-engine-center（手机端审批列表网关用）
            仅通过 perf 的对外 PerfApprovalQueryApi 调用，遵守"模块间只走 *Api"红线；
            不直接依赖 perf 的 service/mapper/entity。
        -->
        <dependency>
            <groupId>com.bank.branch.platform</groupId>
            <artifactId>performance-engine-center</artifactId>
        </dependency>

        <!--
            auth-permission-center（仅用 UserApi）
            报文 EmployeeNo / allocater 工号实为 PT_USER.USERNAME，需经 UserApi.getUsersByUsernames
            转成 perf 下游所需的 USER_ID；同样只走对方 *Api，不碰其 service/mapper/entity。
        -->
        <dependency>
            <groupId>com.bank.branch.platform</groupId>
            <artifactId>auth-permission-center</artifactId>
        </dependency>

        <!-- Netty -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-http</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-handler</artifactId>
        </dependency>

        <!-- JAXB（SOAP XML 解析/序列化，common-web 已有 API，此处确保传递） -->
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
        </dependency>

        <!-- Spring Boot（用于配置属性绑定、生命周期管理） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Hutool JSON（SOAP 报文/callpu JSON 处理）；版本就近声明在本模块，不占用根 pom 统管 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-json</artifactId>
            <version>5.8.0</version>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
