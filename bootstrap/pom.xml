        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- FU-15 B C5：删除 com.h2database:h2 测试依赖，bootstrap IT 已切到本地真 MySQL onepl_test_bootstrap -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- 显式升级 commons-compress 到 1.25.0 以匹配 POI 5.2.5 需要的 putArchiveEntry 新签名 -->
        <!-- 原 MinIO 传递依赖的 1.24.0 与 POI 5.2.5 存在 NoSuchMethodError (AuditLogController.exportLogs 报错) -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>1.25.0</version>
        </dependency>
        <!-- 测试类（LeadE2E / FlowableE2E）仍引用 RedisTemplate，主代码已去 Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Task 17a 修坑②：根 pom 统一管理的 maven-failsafe-plugin（build/plugins，全模块继承）
                默认 classesDirectory 取 ${project.build.outputDirectory}，但 bootstrap 模块的
                spring-boot-maven-plugin:repackage（见下方 execution）会在 package 阶段把
                target/classes 打成 fat jar 并替换 target/bootstrap-*.jar 主构件；标准生命周期下
                repackage 先于 failsafe 的 integration-test 执行，导致 failsafe 解析测试 classpath
                时错误地取到 fat jar（BOOT-INF/classes/... 嵌套结构）而非 target/classes 目录，
                *IT.java 报 "Unable to find a @SpringBootConfiguration"。此处在 bootstrap 显式覆盖
                classesDirectory，强制指回 target/classes，绕开 repackage 产物。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!--
                        宿主机时区可能不是 Asia/Shanghai（开发机常见 PDT/UTC），
                        显式注入 user.timezone 让 LocalDateTime.now() / NOW() 写入北京时间。
                        生产容器若已配 TZ env 则此处冗余但无害。
                    -->
                    <jvmArguments>-Duser.timezone=Asia/Shanghai</jvmArguments>
                </configuration>
                <executions>
                    <!--
                        本项目父 pom 不是 spring-boot-starter-parent，pluginManagement
                        里只声明了 plugin 版本未绑定 goal，所以必须在 bootstrap 模块显式
                        声明 repackage execution，否则 mvn package 只产出 thin jar，
                        无依赖也不可执行（java -jar 报 "no main manifest attribute"）。
                    -->
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
