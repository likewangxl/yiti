<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bank.branch.platform.report.mapper.FreeReportRowMapper">

    <sql id="dataWhere">
        WHERE r.BATCH_ID = #{batchId}
        <if test="keyword != null and keyword != ''">
            AND (r.COL_1 LIKE CONCAT('%', #{keyword}, '%')
                 OR r.COL_2 LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        <if test="empId != null and empId != ''">
            AND r.EMP_ID = #{empId}
        </if>
        <if test="orgCodes != null and orgCodes.size() > 0">
            AND r.ORG_CODE IN
            <foreach collection="orgCodes" item="oc" open="(" separator="," close=")">
                #{oc}
            </foreach>
        </if>
    </sql>

    <select id="countByBatch" resultType="long">
        SELECT COUNT(1) FROM RPT_FREE_REPORT_ROW r
        <include refid="dataWhere"/>
    </select>

    <select id="selectByBatch" resultType="com.bank.branch.platform.report.entity.RptFreeReportRow">
        SELECT * FROM RPT_FREE_REPORT_ROW r
        <include refid="dataWhere"/>
        ORDER BY r.ID ASC
        LIMIT #{offset}, #{pageSize}
    </select>

    <delete id="deleteByBatchId">
        DELETE FROM RPT_FREE_REPORT_ROW WHERE BATCH_ID = #{batchId}
    </delete>
</mapper>
