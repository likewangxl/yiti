<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bank.branch.platform.report.mapper.FreeReportBatchMapper">

    <select id="selectByReportName" resultType="com.bank.branch.platform.report.entity.RptFreeReportBatch">
        SELECT * FROM RPT_FREE_REPORT_BATCH WHERE REPORT_NAME = #{reportName} ORDER BY IMPORT_TIME DESC
    </select>

    <select id="selectAllOrderByImportTimeDesc" resultType="com.bank.branch.platform.report.entity.RptFreeReportBatch">
        SELECT * FROM RPT_FREE_REPORT_BATCH ORDER BY IMPORT_TIME DESC LIMIT 100
    </select>
</mapper>
