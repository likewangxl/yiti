<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bank.branch.platform.report.mapper.RptSnapshotTaskMapper">

    <resultMap id="BaseMap" type="com.bank.branch.platform.report.entity.RptSnapshotTask">
        <id     column="id"             property="id"/>
        <result column="task_name"      property="taskName"/>
        <result column="snapshot_type"  property="snapshotType"/>
        <result column="cron_expr"      property="cronExpr"/>
        <result column="status"         property="status"/>
        <result column="last_run_time"  property="lastRunTime"/>
        <result column="next_run_time"  property="nextRunTime"/>
        <result column="created_time"   property="createdTime"/>
        <result column="updated_time"   property="updatedTime"/>
    </resultMap>

    <sql id="BASE_COLUMNS">
        id, task_name, snapshot_type, cron_expr, status, last_run_time, next_run_time,
        created_time, updated_time
    </sql>

    <!-- insert 由 MyBatis-Plus BaseMapper 提供 -->

    <select id="selectById" resultMap="BaseMap">
        SELECT <include refid="BASE_COLUMNS"/>
          FROM RPT_SNAPSHOT_TASK
         WHERE id = #{id}
    </select>

</mapper>
