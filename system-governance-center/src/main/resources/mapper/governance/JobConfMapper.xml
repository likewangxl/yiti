<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bank.branch.platform.governance.mapper.JobConfMapper">

    <!-- SYS_JOB_CONF 全列查询片段（V1.6 新增 quartz_job_class / misfire_policy） -->
    <sql id="BASE_COLUMNS">
        id, job_key, job_name, cron_expr, quartz_job_class, misfire_policy, status,
        allow_manual_trigger, last_run_time, next_run_time, remark,
        created_by, created_time, updated_by, updated_time
    </sql>

    <!-- 根据任务KEY查询 -->
    <select id="selectByJobKey" parameterType="string"
            resultType="com.bank.branch.platform.governance.entity.SysJobConf">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM SYS_JOB_CONF
        WHERE job_key = #{jobKey}
    </select>

    <!-- selectById / insert / updateById 由 MyBatis-Plus BaseMapper 提供 -->

    <!-- 分页查询任务配置列表 -->
    <select id="selectByPage" resultType="com.bank.branch.platform.governance.entity.SysJobConf">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM SYS_JOB_CONF
        <where>
            <if test="keyword != null and keyword != ''">
                AND (job_key LIKE CONCAT('%', #{keyword}, '%')
                  OR job_name LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        ORDER BY created_time DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- 统计分页查询总记录数 -->
    <select id="countByPage" resultType="long">
        SELECT COUNT(*)
        FROM SYS_JOB_CONF
        <where>
            <if test="keyword != null and keyword != ''">
                AND (job_key LIKE CONCAT('%', #{keyword}, '%')
                  OR job_name LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
    </select>

    <!-- 根据 jobKey 同步更新 last_run_time（V1.6 quartz 整合 P1.5 引入） -->
    <update id="updateLastRunTime">
        UPDATE SYS_JOB_CONF
        SET last_run_time = #{lastRunTime}
        WHERE job_key = #{jobKey}
    </update>

    <!-- 按状态查询任务配置列表（V1.6 quartz 整合 P3.1 引入） -->
    <select id="selectByStatus" resultType="com.bank.branch.platform.governance.entity.SysJobConf">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM SYS_JOB_CONF
        WHERE status = #{status}
        ORDER BY id
    </select>

    <!-- 按主键单独更新状态（V1.6 quartz 整合 P3.3 引入：pauseJob / resumeJob 专用） -->
    <update id="updateStatus">
        UPDATE SYS_JOB_CONF
        SET status = #{status},
            updated_time = NOW()
        WHERE id = #{id}
    </update>

</mapper>
