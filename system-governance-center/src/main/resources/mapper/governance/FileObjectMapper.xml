<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bank.branch.platform.governance.mapper.FileObjectMapper">

    <!-- FILE_OBJECT 全列查询片段 -->
    <sql id="BASE_COLUMNS">
        id, file_name, file_size, file_type, storage_path,
        bucket_name, md5_hash, uploaded_by, uploaded_time
    </sql>

    <!-- insert / selectById / deleteById 由 MyBatis-Plus BaseMapper 提供 -->

    <!-- 根据 MD5 哈希值查询文件对象（用于去重） -->
    <select id="selectByMd5Hash" parameterType="string"
            resultType="com.bank.branch.platform.governance.entity.FileObject">
        SELECT <include refid="BASE_COLUMNS"/>
        FROM FILE_OBJECT
        WHERE md5_hash = #{md5Hash}
        LIMIT 1
    </select>


</mapper>
