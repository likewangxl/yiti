<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bank.branch.platform.governance.mapper.FileObjectMapper">

    <!-- FILE_OBJECT 全列查询片段 -->
    <sql id="BASE_COLUMNS">
        id, file_name, file_size, file_type, storage_path,
        bucket_name, md5_hash, uploaded_by, uploaded_time
    </sql>

    <!-- 新增文件对象记录 -->
    <insert id="insert" parameterType="com.bank.branch.platform.governance.entity.FileObject">
        INSERT INTO FILE_OBJECT (id, file_name, file_size, file_type, storage_path,
                                  bucket_name, md5_hash, uploaded_by, uploaded_time)
        VALUES (#{id}, #{fileName}, #{fileSize}, #{fileType}, #{storagePath},
                #{bucketName}, #{md5Hash}, #{uploadedBy}, #{uploadedTime})
    </insert>

    <!-- 根据主键查询文件对象 -->
    <select id="selectById" parameterType="string"
            resultType="com.bank.branch.platform.governance.entity.FileObject">
        SELECT <include refid="BASE_COLUMNS"/>
        FROM FILE_OBJECT
        WHERE id = #{id}
    </select>

    <!-- 根据 MD5 哈希值查询文件对象（用于去重） -->
    <select id="selectByMd5Hash" parameterType="string"
            resultType="com.bank.branch.platform.governance.entity.FileObject">
        SELECT <include refid="BASE_COLUMNS"/>
        FROM FILE_OBJECT
        WHERE md5_hash = #{md5Hash}
        LIMIT 1
    </select>

    <!-- 根据主键删除文件对象记录 -->
    <delete id="deleteById" parameterType="string">
        DELETE FROM FILE_OBJECT WHERE id = #{id}
    </delete>

</mapper>
