<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bank.branch.platform.governance.mapper.CalendarMapper">

    <!-- SYS_CALENDAR_DAY 全列查询片段 -->
    <sql id="BASE_COLUMNS">
        day, is_workday, remark,
        created_by, created_time, updated_by, updated_time
    </sql>

    <!-- 根据日期查询单条日历记录 -->
    <select id="selectByDay" parameterType="java.time.LocalDate"
            resultType="com.bank.branch.platform.governance.entity.SysCalendarDay">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM SYS_CALENDAR_DAY
        WHERE day = #{day}
    </select>

    <!-- 查询指定日期范围内的日历记录 -->
    <select id="selectByDateRange"
            resultType="com.bank.branch.platform.governance.entity.SysCalendarDay">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM SYS_CALENDAR_DAY
        WHERE day &gt;= #{from}
          AND day &lt;= #{to}
        ORDER BY day ASC
    </select>

    <!-- 查询指定年份的所有日历记录 -->
    <select id="selectByYear"
            resultType="com.bank.branch.platform.governance.entity.SysCalendarDay">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM SYS_CALENDAR_DAY
        WHERE YEAR(day) = #{year}
        ORDER BY day ASC
    </select>

    <!-- 统计指定日期范围内的工作日天数 -->
    <select id="countWorkingDays" resultType="int">
        SELECT COUNT(*)
        FROM SYS_CALENDAR_DAY
        WHERE day &gt;= #{from}
          AND day &lt;= #{to}
          AND is_workday = 1
    </select>

    <!-- insert / updateById 由 MyBatis-Plus BaseMapper 提供 -->

    <!-- 判断指定日期是否已存在 -->
    <select id="existsByDay" parameterType="java.time.LocalDate" resultType="boolean">
        SELECT COUNT(*) > 0
        FROM SYS_CALENDAR_DAY
        WHERE day = #{day}
    </select>

    <delete id="deleteByRange">
        DELETE FROM SYS_CALENDAR_DAY WHERE day BETWEEN #{start} AND #{end}
    </delete>

</mapper>
