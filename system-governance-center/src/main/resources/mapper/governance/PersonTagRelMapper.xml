<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bank.branch.platform.governance.mapper.PersonTagRelMapper">

    <sql id="BASE_COLUMNS">
        ID, TAG_ID, USERNAME, CREATE_BY, CREATE_TIME
    </sql>

    <!-- 分页查询某标签下的关联行，稳定顺序 -->
    <select id="selectPageByTagId"
            resultType="com.bank.branch.platform.governance.entity.PersonTagRel">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM PERSON_TAG_REL
        WHERE TAG_ID = #{tagId}
        ORDER BY CREATE_TIME ASC, ID ASC
        LIMIT #{offset}, #{size}
    </select>

    <!-- 某标签下关联总数 -->
    <select id="countByTagId" resultType="long">
        SELECT COUNT(*) FROM PERSON_TAG_REL WHERE TAG_ID = #{tagId}
    </select>

    <!-- 某标签下已关联的工号集合 -->
    <select id="selectUsernamesByTagId" resultType="string">
        SELECT USERNAME FROM PERSON_TAG_REL WHERE TAG_ID = #{tagId}
    </select>

    <!-- 按标签 ID 集合查全部关联 -->
    <select id="selectByTagIds"
            resultType="com.bank.branch.platform.governance.entity.PersonTagRel">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM PERSON_TAG_REL
        WHERE TAG_ID IN
        <foreach collection="tagIds" item="tid" open="(" separator="," close=")">
            #{tid}
        </foreach>
    </select>

    <!-- 删除某标签下全部关联 -->
    <delete id="deleteByTagId">
        DELETE FROM PERSON_TAG_REL WHERE TAG_ID = #{tagId}
    </delete>

    <!-- 批量插入关联行 -->
    <insert id="insertBatch">
        INSERT INTO PERSON_TAG_REL (TAG_ID, USERNAME, CREATE_BY)
        VALUES
        <foreach collection="rows" item="row" separator=",">
            (#{row.tagId}, #{row.username}, #{row.createBy})
        </foreach>
    </insert>

</mapper>
