    RPT_EXPORT_TASK [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#b4a7d6" COLSPAN="2"><B>RPT_EXPORT_TASK</B><BR/><FONT POINT-SIZE="8">报表异步导出任务</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">🔑 id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">导出任务ID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">PENDING/RUNNING/SU…</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="file_key">file_key</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">governance.file_ob…</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="operator_id">operator_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">操作人员工号</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#888888">…还有 8 列见 Excel…</FONT></TD></TR></TABLE>>];
  }

