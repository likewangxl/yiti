  }

  subgraph cluster_portal {
    label=<<B>门户内容中心</B><BR/><FONT POINT-SIZE="9">portal-content-center</FONT>>;
    style="filled,rounded"; fillcolor="#bdd7ee33"; color="#bdd7ee"; penwidth=2;
    PORTAL_NAV [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#bdd7ee" COLSPAN="2"><B>PORTAL_NAV</B><BR/><FONT POINT-SIZE="8">网址导航表</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">🔑 id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">导航ID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">ACTIVE/DISABLED</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#888888">…还有 9 列见 Excel…</FONT></TD></TR></TABLE>>];
    PORTAL_SHORTCUT [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#bdd7ee" COLSPAN="2"><B>PORTAL_SHORTCUT</B><BR/><FONT POINT-SIZE="8">工作台快捷入口表</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">🔑 id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">快捷入口ID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="emp_id">emp_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">所属用户工号(自定义快捷入口)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">ACTIVE/DISABLED</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#888888">…还有 10 列见 Excel…</FONT></TD></TR></TABLE>>];
