    WF_NODE_FORM_CONF [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#c6e0b4" COLSPAN="2"><B>WF_NODE_FORM_CONF</B><BR/><FONT POINT-SIZE="8">流程节点表单配置表</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">🔑 id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">配置ID</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#888888">…还有 7 列见 Excel…</FONT></TD></TR></TABLE>>];
