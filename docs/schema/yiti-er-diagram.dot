// yiti(分行业务平台) 数据表关联图 — Graphviz dot
// 渲染:
//   dot -Tsvg yiti-er-diagram.dot -o yiti-er.svg
//   dot -Tpng -Gdpi=180 yiti-er-diagram.dot -o yiti-er.png
digraph yiti {
  graph [rankdir=LR, splines=spline, overlap=false, fontname="Microsoft YaHei", concentrate=true, nodesep=0.4, ranksep=0.9];
  node  [shape=plaintext, fontname="Microsoft YaHei", fontsize=11];
  edge  [fontname="Microsoft YaHei", fontsize=9, color="#555555"];

  subgraph cluster_auth {
    label=<<B>认证授权中心</B><BR/><FONT POINT-SIZE="9">auth-permission-center</FONT>>;
    style="filled,rounded"; fillcolor="#9bc2e633"; color="#9bc2e6"; penwidth=2;
    PT_USER [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#9bc2e6" COLSPAN="2"><B>PT_USER</B><BR/><FONT POINT-SIZE="8">人员表(用户)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="USER_ID">🔑 USER_ID</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">用户ID(工号)</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#888888">…还有 14 列见 Excel…</FONT></TD></TR></TABLE>>];
    PT_ROLE [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#9bc2e6" COLSPAN="2"><B>PT_ROLE</B><BR/><FONT POINT-SIZE="8">角色表</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ROLE_ID">🔑 ROLE_ID</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">角色ID</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#888888">…还有 9 列见 Excel…</FONT></TD></TR></TABLE>>];
    PT_RESOURCE [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#9bc2e6" COLSPAN="2"><B>PT_RESOURCE</B><BR/><FONT POINT-SIZE="8">资源表(菜单/接口)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="RESOURCE_ID">🔑 RESOURCE_ID</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">资源ID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="PARENT_RESOURCE_ID">PARENT_RESOURCE_ID</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">上级资源ID(自关联)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="STATUS">STATUS</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int</FONT> <FONT COLOR="#999999" POINT-SIZE="8">0 启用 1 不启用</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#888888">…还有 13 列见 Excel…</FONT></TD></TR></TABLE>>];
    PT_USER_ROLE [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#9bc2e6" COLSPAN="2"><B>PT_USER_ROLE</B><BR/><FONT POINT-SIZE="8">用户角色关联表</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="USER_ID">🔑 USER_ID</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">用户ID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ROLE_ID">🔑 ROLE_ID</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">角色ID</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#888888">…还有 4 列见 Excel…</FONT></TD></TR></TABLE>>];
    PT_ROLE_RESOURCE [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#9bc2e6" COLSPAN="2"><B>PT_ROLE_RESOURCE</B><BR/><FONT POINT-SIZE="8">角色资源关联表</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ID">🔑 ID</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">主键ID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ROLE_ID">ROLE_ID</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">角色ID</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#888888">…还有 3 列见 Excel…</FONT></TD></TR></TABLE>>];
    PT_ROLE_BIZ_SCOPE [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#9bc2e6" COLSPAN="2"><B>PT_ROLE_BIZ_SCOPE</B><BR/><FONT POINT-SIZE="8">角色业务范围表(数据范围核心)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ID">🔑 ID</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">主键ID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ROLE_ID">ROLE_ID</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">角色ID</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#888888">…还有 8 列见 Excel…</FONT></TD></TR></TABLE>>];
    EXT_ORG_INFO [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#9bc2e6" COLSPAN="2"><B>EXT_ORG_INFO</B><BR/><FONT POINT-SIZE="8">机构表</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ID">🔑 ID</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">int</FONT> <FONT COLOR="#999999" POINT-SIZE="8">机构主键</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ORG_CODE">ORG_CODE</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">机构编号(业务键)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="P_ID">P_ID</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">上级机构编码(自关联,树形)</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#888888">…还有 7 列见 Excel…</FONT></TD></TR></TABLE>>];
    EXT_USER_ORG [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#9bc2e6" COLSPAN="2"><B>EXT_USER_ORG</B><BR/><FONT POINT-SIZE="8">用户机构关联表</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="USER_ID">🔑 USER_ID</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">用户ID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ORG_CODE">🔑 ORG_CODE</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">机构编码</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#888888">…还有 1 列见 Excel…</FONT></TD></TR></TABLE>>];
  }

  subgraph cluster_governance {
    label=<<B>系统治理中心</B><BR/><FONT POINT-SIZE="9">system-governance-center</FONT>>;
    style="filled,rounded"; fillcolor="#ffc00033"; color="#ffc000"; penwidth=2;
    SYS_DICT [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#ffc000" COLSPAN="2"><B>SYS_DICT</B><BR/><FONT POINT-SIZE="8">字典表(类型+项合并存储)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">🔑 id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">字典ID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">ACTIVE/DISABLED</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#888888">…还有 10 列见 Excel…</FONT></TD></TR></TABLE>>];
    SYS_DICT_ITEM [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#ffc000" COLSPAN="2"><B>SYS_DICT_ITEM</B><BR/><FONT POINT-SIZE="8">字典项表(预留拆分用)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">🔑 id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">字典项ID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">ACTIVE/DISABLED</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#888888">…还有 10 列见 Excel…</FONT></TD></TR></TABLE>>];
    SYS_CALENDAR_DAY [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#ffc000" COLSPAN="2"><B>SYS_CALENDAR_DAY</B><BR/><FONT POINT-SIZE="8">工作日历(按天)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="day">🔑 day</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">date</FONT> <FONT COLOR="#999999" POINT-SIZE="8">日期</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#888888">…还有 6 列见 Excel…</FONT></TD></TR></TABLE>>];
    SYS_JOB_CONF [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#ffc000" COLSPAN="2"><B>SYS_JOB_CONF</B><BR/><FONT POINT-SIZE="8">任务调度配置(Quartz 包装)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">🔑 id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">任务ID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">ACTIVE/PAUSED</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#888888">…还有 13 列见 Excel…</FONT></TD></TR></TABLE>>];
    SYS_JOB_RUN_LOG [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#ffc000" COLSPAN="2"><B>SYS_JOB_RUN_LOG</B><BR/><FONT POINT-SIZE="8">任务执行日志</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">🔑 id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">执行日志ID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="job_id">job_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">任务ID(逻辑外键→sys_job_…</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">RUNNING/SUCCESS/FA…</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#888888">…还有 8 列见 Excel…</FONT></TD></TR></TABLE>>];
    SYS_CONFIG_KV [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#ffc000" COLSPAN="2"><B>SYS_CONFIG_KV</B><BR/><FONT POINT-SIZE="8">系统配置 KV</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">🔑 id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">配置ID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">ACTIVE/DISABLED</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#888888">…还有 8 列见 Excel…</FONT></TD></TR></TABLE>>];
    USER_NOTIFICATION [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#ffc000" COLSPAN="2"><B>USER_NOTIFICATION</B><BR/><FONT POINT-SIZE="8">用户通知表</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">🔑 id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">通知ID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="emp_id">emp_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">接收人工号(逻辑外键→addrboo…</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#888888">…还有 9 列见 Excel…</FONT></TD></TR></TABLE>>];
    FILE_OBJECT [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#ffc000" COLSPAN="2"><B>FILE_OBJECT</B><BR/><FONT POINT-SIZE="8">文件对象表(对象存储元数据)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">🔑 id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">文件对象ID</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#888888">…还有 8 列见 Excel…</FONT></TD></TR></TABLE>>];
    BIZ_FILE_REL [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#ffc000" COLSPAN="2"><B>BIZ_FILE_REL</B><BR/><FONT POINT-SIZE="8">业务-附件关联表</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">🔑 id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">关联ID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="file_object_id">file_object_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">文件对象ID(逻辑外键→file_o…</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#888888">…还有 5 列见 Excel…</FONT></TD></TR></TABLE>>];
    AUDIT_LOG [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#ffc000" COLSPAN="2"><B>AUDIT_LOG</B><BR/><FONT POINT-SIZE="8">审计日志表(高危操作 + 链路追踪)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">🔑 id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">日志ID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="emp_id">emp_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">操作人工号</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#888888">…还有 14 列见 Excel…</FONT></TD></TR></TABLE>>];
  }

  subgraph cluster_workflow {
    label=<<B>工作流中心</B><BR/><FONT POINT-SIZE="9">workflow-center</FONT>>;
    style="filled,rounded"; fillcolor="#c6e0b433"; color="#c6e0b4"; penwidth=2;
    BIZ_PROCESS_MAP [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#c6e0b4" COLSPAN="2"><B>BIZ_PROCESS_MAP</B><BR/><FONT POINT-SIZE="8">业务流程映射表(business_key↔Flowable 实例)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">🔑 id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">映射ID</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="business_key">business_key</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">业务键(BIZ_TYPE:id)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="process_instance_id">process_instance_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">varchar</FONT> <FONT COLOR="#999999" POINT-SIZE="8">Flowable 流程实例ID</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#888888">…还有 12 列见 Excel…</FONT></TD></TR></TABLE>>];
