      "source": "docs/superpowers/sql/2026-08-11-auth-org-profile-group.sql",
      "expected_failure": "审批身份分支缺少可执行条件",
      "patches": [
        {
          "old": "        WHEN @approved_target_server_uuid IS NULL",
          "new": "        WHEN '@approved_target_server_uuid IS NULL' = ''"
