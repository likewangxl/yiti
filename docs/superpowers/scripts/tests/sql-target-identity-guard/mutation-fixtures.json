      "patches": [
        {
          "old": "             OR BINARY @approved_target_port <> BINARY CAST(@@port AS CHAR)",
          "new": "             OR 1 = 0 /* BINARY @approved_target_port <> BINARY CAST(@@port AS CHAR) */"
        }
      ]
    },
