@startuml yiti_er_auth-permission-center
skinparam dpi 110
skinparam classFontName Microsoft YaHei
skinparam classFontSize 12
skinparam packageStyle rectangle
skinparam linetype ortho
title 01-认证授权中心 — 内部表与跨模块引用 (虚线=逻辑/实线=物理)

package "01-认证授权中心" #E3F2FD {
  entity "EXT_ORG_INFO" as EXT_ORG_INFO {
    .. 机构表 ..
    PK: ID
    + ORG_CODE
    + CREATE_USER
  }
  entity "EXT_USER_ORG" as EXT_USER_ORG {
    .. 用户机构关联表 ..
    PK: USER_ID, ORG_CODE
    + USER_ID
    + ORG_CODE
  }
  entity "PT_RESOURCE" as PT_RESOURCE {
    .. 资源表 ..
    PK: RESOURCE_ID
    + RESOURCE_ID
    + CREATE_USER
    + UPDATE_USER
  }
  entity "PT_ROLE" as PT_ROLE {
    .. 角色表 ..
    PK: ROLE_ID
    + ROLE_ID
    + CREATE_USER
    + UPDATE_USER
  }
  entity "PT_ROLE_BIZ_SCOPE" as PT_ROLE_BIZ_SCOPE {
    .. 角色业务范围表 ..
    PK: ID
    + ROLE_ID
    + CREATE_USER
    + UPDATE_USER
  }
  entity "PT_ROLE_RESOURCE" as PT_ROLE_RESOURCE {
    .. 角色资源关联表 ..
    PK: ID
    + ROLE_ID
    + RESOURCE_ID
  }
  entity "PT_USER" as PT_USER {
    .. 人员表 ..
    PK: USER_ID
    + USER_ID
  }
  entity "PT_USER_ROLE" as PT_USER_ROLE {
    .. 用户角色关联表 ..
    PK: USER_ID, ROLE_ID
    + USER_ID
    + ROLE_ID
  }
}

