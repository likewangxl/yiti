<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bank.branch.platform</groupId>
        <artifactId>branch-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>performance-engine-center</artifactId>
    <name>Performance Engine Center</name>
    <description>绩效计算中心：指标库、KPI 方案、目标管理、分配关系查询、数据版本控制 (V1.0 配置与版本骨架)</description>

    <dependencies>
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Common 模块 -->
        <dependency>
            <groupId>com.bank.branch.platform</groupId>
            <artifactId>common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bank.branch.platform</groupId>
            <artifactId>common-trace</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bank.branch.platform</groupId>
            <artifactId>common-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bank.branch.platform</groupId>
            <artifactId>common-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bank.branch.platform</groupId>
            <artifactId>common-db</artifactId>
        </dependency>

        <!-- auth-permission-center -->
        <dependency>
            <groupId>com.bank.branch.platform</groupId>
            <artifactId>auth-permission-center</artifactId>
        </dependency>

        <!-- system-governance-center -->
        <dependency>
            <groupId>com.bank.branch.platform</groupId>
            <artifactId>system-governance-center</artifactId>
        </dependency>

        <!--
            workflow-center (V1.2 新增)
            V1.2 分配关系调整审批、目标修正审批通过 WorkflowApi.startProcess 启动 BPMN 流程；
            Flowable RepositoryService 作为传递依赖可用，用于 BPMN 显式部署.
            workflow-center 自身不依赖任何业务模块，无循环依赖风险.
        -->
        <dependency>
            <groupId>com.bank.branch.platform</groupId>
            <artifactId>workflow-center</artifactId>
        </dependency>

        <!--
            customer-marketing-center (V1.2 新增)
            V1.2 分配调整提交时调用 CustomerQueryApi.getCustomer 校验客户存在与归属，
            必要时调 ClaimApi 校验认领状态.
            customer-marketing-center 不依赖 performance-engine-center，无循环依赖风险.
        -->
        <dependency>
            <groupId>com.bank.branch.platform</groupId>
            <artifactId>customer-marketing-center</artifactId>
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Redis (V1.0 用于配置缓存 + 槽位分布式锁) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- MyBatis -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>

        <!--
            Quartz 调度引擎（V1.6 引入）
            Spring Boot 3.2.3 默认管理 Quartz 2.3.2 + JDBC JobStore 集群模式（isClustered=true）
            用途：performance-engine 持有 3 个业务 Job + 3 Quartz 包装类，需要 Quartz API 编译
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-quartz</artifactId>
        </dependency>

        <!-- API 文档 -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MySQL 真实库测试驱动 (application-test.yml 使用本地 onepl 库) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Flyway（迁移脚本集成测试使用，test scope 仅覆盖 migration IT） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ArchUnit：架构守护测试（禁止 Controller 返回 entity 等架构规则） -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.2.1</version>
            <scope>test</scope>
        </dependency>

        <!-- V1.1 指标公式引擎（Groovy 4.0.21 解释型执行） -->
        <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy</artifactId>
            <version>4.0.21</version>
        </dependency>

        <!-- V1.1 数据导入/导出（EasyExcel 3.3.4） -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>easyexcel</artifactId>
            <version>3.3.4</version>
        </dependency>

        <!--
            Task P5.2 显式对齐 commons-compress 1.25.0（POI 5.2.5 需要），覆盖 minio 传递的 1.24.0.
            缘由：minio 8.5.7 依赖 commons-compress:1.24.0，但 system-governance-center 引入的
            poi-ooxml:5.2.5 实际需要 1.25.0 的 putArchiveEntry 签名；不锁版会导致
            EasyExcel.write 抛 NoSuchMethodError（POI + commons-compress 版本不对齐）。
        -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>1.25.0</version>
        </dependency>

        <!--
            V1.3 Task R5.1 Testcontainers-redis 接入.
            用途：DataTaskServiceIdempotentIT / SysControlConcurrentIT 等并发 IT
            依赖真实 Redis，过往需要开发者本地 localhost:6379 已启动；
            V1.3 引入 Testcontainers-redis 让 IT 自启 Redis 容器，无需手动预置。

            版本选择：com.redis:testcontainers-redis 不在 org.testcontainers:testcontainers-bom
            管理范围内（第三方扩展，非官方 org.testcontainers GroupId），需独立 version。
            2.2.2 是 2024 年维护版本，兼容 testcontainers-core 1.19.7（本 POM parent 已引）。

            Docker 依赖：无 Docker 环境会在 Testcontainers 尝试启动容器时抛异常，
            PerformanceRedisTestBase 默认 @EnabledIfSystemProperty 守护，CI 通过
            -Dtestcontainers.enabled=true 启用；本地开发跑 mvn verify 时默认跳过避免阻塞。
        -->
        <dependency>
            <groupId>com.redis</groupId>
            <artifactId>testcontainers-redis</artifactId>
            <version>2.2.2</version>
            <scope>test</scope>
        </dependency>
        <!--
            testcontainers JUnit 5 扩展（@Testcontainers / @Container 注解所在包）
            版本由根 POM 的 testcontainers-bom (1.19.7) 统一管理，无需显式 version。
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
