<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  KpiResultMapper XML（V1.1 Task P1.2）.

  表结构与宽表不同：主键 bigint AUTO_INCREMENT（insert 使用 useGeneratedKeys 回填 id），
  业务唯一键 uk_emp_cycle_asof(emp_id, cycle_type, cycle_date, as_of_date)。
-->
<mapper namespace="com.bank.branch.platform.performance.mapper.KpiResultMapper">

    <sql id="BASE_COLUMNS">
        id, emp_id, cycle_type, cycle_date, as_of_date, data_version,
        kpi_total_score, detail_json, calculated_time
    </sql>

    <!-- insert / selectById 由 MyBatis-Plus BaseMapper 提供 -->

    <select id="selectByEmpCycle" resultType="com.bank.branch.platform.performance.entity.KpiResult">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM KPI_RESULT
        WHERE emp_id = #{empId}
          AND cycle_type = #{cycleType}
        ORDER BY as_of_date DESC, id DESC
    </select>

    <!-- V1.1 P4.3：查最新一条 -->
    <select id="selectLatestByEmpCycle" resultType="com.bank.branch.platform.performance.entity.KpiResult">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM KPI_RESULT
        WHERE emp_id = #{empId}
          AND cycle_type = #{cycleType}
        ORDER BY as_of_date DESC, id DESC
        LIMIT 1
    </select>

    <!-- V1.1 P4.3：按 as_of_date [from, to] 范围查询 -->
    <select id="selectByEmpCycleRange" resultType="com.bank.branch.platform.performance.entity.KpiResult">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM KPI_RESULT
        WHERE emp_id = #{empId}
          AND cycle_type = #{cycleType}
          AND as_of_date BETWEEN #{from} AND #{to}
        ORDER BY as_of_date DESC, id DESC
    </select>

    <!--
      Q7.3 新增：基于 PerfScopeHelper 的数据范围注入版本.
      scopeFragment 由 PerfScopeHelper 生成 (SELF → "emp_id = #{scopeParams.ownerEmpId}"),
      Mapper 通过 AND (${scopeFragment}) 拼接, 参数走 #{scopeParams.xxx} 预编译.
    -->
    <select id="selectByEmpCycleRangeWithScope" resultType="com.bank.branch.platform.performance.entity.KpiResult">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM KPI_RESULT
        <where>
            emp_id = #{empId}
            AND cycle_type = #{cycleType}
            AND as_of_date BETWEEN #{from} AND #{to}
            <if test="scopeFragment != null and scopeFragment != ''">
                AND (${scopeFragment})
            </if>
        </where>
        ORDER BY as_of_date DESC, id DESC
    </select>

    <!-- V1.2 Q6.2：按 (cycleType, cycleDate, asOfDate) 批量导出查询 -->
    <select id="selectForExport" resultType="com.bank.branch.platform.performance.entity.KpiResult">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM KPI_RESULT
        WHERE cycle_type = #{cycleType}
          AND cycle_date = #{cycleDate}
          AND as_of_date = #{asOfDate}
          <if test="dataVersion != null and dataVersion != ''">
              AND data_version = #{dataVersion}
          </if>
        ORDER BY emp_id ASC, id ASC
        LIMIT #{limit}
    </select>

    <!-- V1.2 Q6.2：计数，用于导出前行数预检 -->
    <select id="countForExport" resultType="long">
        SELECT COUNT(*)
        FROM KPI_RESULT
        WHERE cycle_type = #{cycleType}
          AND cycle_date = #{cycleDate}
          AND as_of_date = #{asOfDate}
          <if test="dataVersion != null and dataVersion != ''">
              AND data_version = #{dataVersion}
          </if>
    </select>

    <!--
      V1.14 任务 A：列举近期被考核员工工号集合.
      - sinceDate 必填；as_of_date >= #{sinceDate} 限近期窗口
      - orgCodes 非空时 LEFT JOIN EXT_USER_ORG 做机构子树裁剪；
        orgCodes 为 null 时（管理员场景）不 JOIN，全表 distinct
      - 返回 distinct emp_id 升序，前端可直接用作员工工号集合
    -->
    <select id="selectEvalEmpIds" resultType="java.lang.String">
        SELECT DISTINCT k.emp_id
        FROM KPI_RESULT k
        <if test="orgCodes != null and !orgCodes.isEmpty()">
            LEFT JOIN EXT_USER_ORG u ON k.emp_id = u.user_id
        </if>
        <where>
            k.as_of_date &gt;= #{sinceDate}
            <if test="orgCodes != null and !orgCodes.isEmpty()">
                AND u.org_code IN
                <foreach collection="orgCodes" item="o" open="(" separator="," close=")">
                    #{o}
                </foreach>
            </if>
        </where>
        ORDER BY k.emp_id ASC
    </select>

</mapper>
