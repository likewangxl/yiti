<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bank.branch.platform.performance.mapper.SysControlMapper">

    <!-- SYS_CONTROL 全列片段（V1.0.3：12 字段，含 Task B3 新增的 5 个字段） -->
    <sql id="BASE_COLUMNS">
        id, scope_dim, latest_data_date, current_version, is_valid, created_time, updated_time,
        remark, updated_by, publish_source, publish_by, publish_time
    </sql>

    <!-- insert / selectById 由 MyBatis-Plus BaseMapper 提供 -->

    <!-- 查询维度下当前生效版本 -->
    <select id="selectByScopeAndValid" resultType="com.bank.branch.platform.performance.entity.SysControl">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM SYS_CONTROL
        WHERE scope_dim = #{scopeDim} AND is_valid = 1
        LIMIT 1
    </select>

    <!-- 查询维度下全部历史, 按 latest_data_date 倒序 -->
    <select id="listByScope" resultType="com.bank.branch.platform.performance.entity.SysControl">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM SYS_CONTROL
        WHERE scope_dim = #{scopeDim}
        ORDER BY latest_data_date DESC
        LIMIT #{limit}
    </select>

    <!-- 更新 is_valid -->
    <update id="updateIsValid">
        UPDATE SYS_CONTROL
        SET is_valid = #{isValid}, updated_time = NOW()
        WHERE id = #{id}
    </update>

    <!-- 选择性更新（V1.0.3：含发布元数据字段） -->
    <update id="updateByIdSelective" parameterType="com.bank.branch.platform.performance.entity.SysControl">
        UPDATE SYS_CONTROL
        <set>
            <if test="isValid != null">is_valid = #{isValid},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updatedBy != null">updated_by = #{updatedBy},</if>
            <if test="publishSource != null">publish_source = #{publishSource},</if>
            <if test="publishBy != null">publish_by = #{publishBy},</if>
            <if test="publishTime != null">publish_time = #{publishTime},</if>
            updated_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <!-- 条件查询 -->
    <select id="selectByCondition" resultType="com.bank.branch.platform.performance.entity.SysControl">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM SYS_CONTROL
        <where>
            <if test="scopeDim != null and scopeDim != ''">
                AND scope_dim = #{scopeDim}
            </if>
            <if test="isValid != null">
                AND is_valid = #{isValid}
            </if>
        </where>
        ORDER BY latest_data_date DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- 条件计数 -->
    <select id="countByCondition" resultType="long">
        SELECT COUNT(*)
        FROM SYS_CONTROL
        <where>
            <if test="scopeDim != null and scopeDim != ''">
                AND scope_dim = #{scopeDim}
            </if>
            <if test="isValid != null">
                AND is_valid = #{isValid}
            </if>
        </where>
    </select>

    <!-- V1.2 Task Q5.1：distinct scope_dim 列表（历史版本清理驱动） -->
    <select id="selectScopeDims" resultType="string">
        SELECT DISTINCT scope_dim
        FROM SYS_CONTROL
    </select>

    <!--
        V1.2 Task Q5.1：按 scope_dim 查询应被清理的历史版本 id.
        语义：仅取 is_valid=0，按 publish_time / id 倒序保留最新 keepCount 条，超出部分返回 id 清单.
        注意：publish_time 在 V1.0.3 之前历史数据可能为 NULL，为保证倒序稳定性，使用 id DESC 兜底.
    -->
    <select id="selectOldVersionIdsForCleanup" resultType="string">
        SELECT id
        FROM SYS_CONTROL
        WHERE scope_dim = #{scopeDim}
          AND is_valid = 0
        ORDER BY publish_time DESC, id DESC
        LIMIT #{keepCount}, 1000000
    </select>

    <!--
        V1.2 Task Q5.1：按 id 列表批量硬删除.
        调用方必须保证 ids 来自 selectOldVersionIdsForCleanup（绝不含 is_valid=1 的当前行）.
        ids 为空时 SQL 构造为 "WHERE id IN ()" 会报语法错，Service 层须前置判空.
    -->
    <delete id="deleteByIds">
        DELETE FROM SYS_CONTROL
        WHERE id IN
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
