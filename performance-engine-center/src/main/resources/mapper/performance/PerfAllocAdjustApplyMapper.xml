<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bank.branch.platform.performance.mapper.PerfAllocAdjustApplyMapper">

    <sql id="BASE_COLUMNS">
        id, apply_no, cust_id, cust_no, cust_name, curr_bal, m_avg_bal, q_avg_bal, y_avg_bal,
        cust_type, alloc_dim, biz_kind, account_no, status,
        business_key, process_instance_id, owner_org_id, remark,
        created_by, created_time, updated_by, updated_time
    </sql>

    <!-- insert / selectById(Serializable) / updateById / deleteById 由 BaseMapper 提供，无需在此定义 -->

    <!-- selectByAllocApplyId: 自定义按主键查询，避免与 BaseMapper.selectById(Serializable) 签名冲突 -->
    <select id="selectByAllocApplyId" resultType="com.bank.branch.platform.performance.entity.PerfAllocAdjustApply">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM PERF_ALLOC_ADJUST_APPLY
        WHERE id = #{id}
        LIMIT 1
    </select>

    <select id="selectByApplyNo" resultType="com.bank.branch.platform.performance.entity.PerfAllocAdjustApply">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM PERF_ALLOC_ADJUST_APPLY
        WHERE apply_no = #{applyNo}
        LIMIT 1
    </select>

    <select id="selectByBusinessKey" resultType="com.bank.branch.platform.performance.entity.PerfAllocAdjustApply">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM PERF_ALLOC_ADJUST_APPLY
        WHERE business_key = #{businessKey}
        LIMIT 1
    </select>

    <!-- 同客户同分配维度下审批中(IN_APPROVAL)申请计数（去重粒度 cust_id + alloc_dim） -->
    <select id="countInApprovalByCustAndDim" resultType="long">
        SELECT COUNT(*)
        FROM PERF_ALLOC_ADJUST_APPLY
        WHERE status = 'IN_APPROVAL'
          AND cust_no = #{custNo}
          AND alloc_dim = #{allocDim}
    </select>

    <!-- 某客户某分配维度下「审批通过的最后一条」申请（原业绩分配预览） -->
    <select id="selectLastApprovedByCustAndDim" resultType="com.bank.branch.platform.performance.entity.PerfAllocAdjustApply">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM PERF_ALLOC_ADJUST_APPLY
        WHERE cust_id = #{custId}
          AND alloc_dim = #{allocDim}
          AND status = 'APPROVED'
        ORDER BY created_time DESC, id DESC
        LIMIT 1
    </select>

    <!--
      更新状态 + processInstanceId。
      processInstanceId 为 null 时不覆写（保留历史值），避免 AllocAdjustCompletedListener
      APPROVED 路径更新状态时清空流程 ID。
    -->
    <update id="updateStatus">
        UPDATE PERF_ALLOC_ADJUST_APPLY
        <set>
            status = #{status},
            <if test="processInstanceId != null">
                process_instance_id = #{processInstanceId},
            </if>
            updated_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <sql id="CONDITION_WHERE">
        <where>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="bizKind != null and bizKind != ''">
                AND biz_kind = #{bizKind}
            </if>
            <if test="custId != null and custId != ''">
                AND cust_id = #{custId}
            </if>
            <if test="ownerOrgId != null and ownerOrgId != ''">
                AND owner_org_id = #{ownerOrgId}
            </if>
            <if test="createdBy != null and createdBy != ''">
                AND created_by = #{createdBy}
            </if>
        </where>
    </sql>

    <select id="selectByConditions" resultType="com.bank.branch.platform.performance.entity.PerfAllocAdjustApply">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM PERF_ALLOC_ADJUST_APPLY
        <include refid="CONDITION_WHERE"/>
        ORDER BY created_time DESC, id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countByConditions" resultType="long">
        SELECT COUNT(*)
        FROM PERF_ALLOC_ADJUST_APPLY
        <include refid="CONDITION_WHERE"/>
    </select>

    <!--
      V1.4 S1.3 新增: 带 scopeFragment 注入的条件分页与计数.
      scopeFragment 由 PerfScopeHelper 受控生成, 通过 ${} 注入;
      参数走 #{scopeParams.*} 预编译. 空片段 → 不附加; "1=0" → fail-close.
    -->
    <sql id="CONDITION_WHERE_WITH_SCOPE">
        <where>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="bizKind != null and bizKind != ''">
                AND biz_kind = #{bizKind}
            </if>
            <if test="custId != null and custId != ''">
                AND cust_id = #{custId}
            </if>
            <if test="ownerOrgId != null and ownerOrgId != ''">
                AND owner_org_id = #{ownerOrgId}
            </if>
            <if test="createdBy != null and createdBy != ''">
                AND created_by = #{createdBy}
            </if>
            <if test="scopeFragment != null and scopeFragment != ''">
                AND (${scopeFragment})
            </if>
        </where>
    </sql>

    <select id="selectByConditionsWithScope" resultType="com.bank.branch.platform.performance.entity.PerfAllocAdjustApply">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM PERF_ALLOC_ADJUST_APPLY
        <include refid="CONDITION_WHERE_WITH_SCOPE"/>
        ORDER BY created_time DESC, id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countByConditionsWithScope" resultType="long">
        SELECT COUNT(*)
        FROM PERF_ALLOC_ADJUST_APPLY
        <include refid="CONDITION_WHERE_WITH_SCOPE"/>
    </select>

</mapper>
