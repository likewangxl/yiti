<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  PerfRunTaskMapper XML (只读).

  V1.0 仅暴露读方法：selectById / selectByTaskNo / selectByCondition / countByCondition / countByTypeAndDate。
  写入由 V1.1 计算引擎模块提供。

  安全 (SQL 注入) 声明:
    selectByCondition / countByCondition 中的 ${dataScopeFilter} 为 common-dev-guide §5 允许的
    合法数据范围 SQL 片段注入；调用方必须保证该参数由 common-security DataScopeApi 可信生成，
    禁止接收任何用户输入直接拼入。其他参数一律使用 #{} 预编译占位符。
-->
<mapper namespace="com.bank.branch.platform.performance.mapper.PerfRunTaskMapper">

    <sql id="BASE_COLUMNS">
        id, task_type, task_key, data_date, data_version, params_json,
        status, started_by, start_time, end_time, error_msg, result_preview_json, created_time
    </sql>

    <select id="selectById" resultType="com.bank.branch.platform.performance.entity.PerfRunTask">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM perf_run_task
        WHERE id = #{id}
        LIMIT 1
    </select>

    <!--
        V1.0 语义：task_key 既承担 "关键键"（如 metric_code），也承担 "任务编号"。
        V1.1 若 DDL 新增独立 task_no 列，仅需改本处底层列名，接口保持不变。
    -->
    <select id="selectByTaskNo" resultType="com.bank.branch.platform.performance.entity.PerfRunTask">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM perf_run_task
        WHERE task_key = #{taskNo}
        LIMIT 1
    </select>

    <select id="selectByCondition" resultType="com.bank.branch.platform.performance.entity.PerfRunTask">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM perf_run_task
        <where>
            <if test="taskType != null and taskType != ''">
                AND task_type = #{taskType}
            </if>
            <if test="taskKey != null and taskKey != ''">
                AND task_key = #{taskKey}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="dataDate != null">
                AND data_date = #{dataDate}
            </if>
            <!--
                数据范围 SQL 片段注入 (合法 ${}):
                - null / 空串 -> 管理员全见
                - 非空 -> 由 DataScopeApi 生成形如 " AND started_by = 'xxx' "
                调用方必须保证来源可信, 见 Mapper Javadoc 的安全声明.
            -->
            <if test="dataScopeFilter != null and dataScopeFilter != ''">
                ${dataScopeFilter}
            </if>
        </where>
        ORDER BY start_time DESC, id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countByCondition" resultType="long">
        SELECT COUNT(*)
        FROM perf_run_task
        <where>
            <if test="taskType != null and taskType != ''">
                AND task_type = #{taskType}
            </if>
            <if test="taskKey != null and taskKey != ''">
                AND task_key = #{taskKey}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="dataDate != null">
                AND data_date = #{dataDate}
            </if>
            <!-- 数据范围 SQL 片段注入，语义同 selectByCondition. -->
            <if test="dataScopeFilter != null and dataScopeFilter != ''">
                ${dataScopeFilter}
            </if>
        </where>
    </select>

    <select id="countByTypeAndDate" resultType="long">
        SELECT COUNT(*)
        FROM perf_run_task
        WHERE task_type = #{taskType}
          AND data_date = #{dataDate}
    </select>

    <!--
        V1.1 Task P2.4 起扩展写方法：由计算引擎写入任务记录.
        注意：created_time 由 DB 默认值 CURRENT_TIMESTAMP 填充；start_time 由代码显式传入。
    -->
    <insert id="insert" parameterType="com.bank.branch.platform.performance.entity.PerfRunTask">
        INSERT INTO perf_run_task (
            id, task_type, task_key, data_date, data_version, params_json,
            status, started_by, start_time, end_time, error_msg, result_preview_json
        ) VALUES (
            #{id}, #{taskType}, #{taskKey}, #{dataDate}, #{dataVersion}, #{paramsJson},
            #{status}, #{startedBy}, #{startTime}, #{endTime}, #{errorMsg}, #{resultPreviewJson}
        )
    </insert>

    <!--
        状态机：PENDING -> RUNNING -> SUCCESS/FAILED/PARTIAL/CANCELLED.
        当 status 为终态（SUCCESS/FAILED/PARTIAL/CANCELLED）时，end_time 自动设为 NOW()；
        RUNNING 状态时 end_time 清空。
        errorMsg 为 null 时清空 error_msg 列（业务语义：重试成功时抹去上一次错误信息）。
    -->
    <update id="updateStatus">
        UPDATE perf_run_task
        SET status = #{status},
            error_msg = #{errorMsg},
            end_time = <choose>
                <when test="status == 'SUCCESS' or status == 'FAILED' or status == 'PARTIAL' or status == 'CANCELLED'">
                    NOW()
                </when>
                <otherwise>
                    NULL
                </otherwise>
            </choose>
        WHERE id = #{id}
    </update>

    <!--
        V1.1 P8 Task C.1：单列更新 result_preview_json，不触碰 status/end_time/error_msg.
        由 HistoryRecalcService 写入 childTaskIds JSON 数组。
    -->
    <update id="updateResultPreviewJson">
        UPDATE perf_run_task
        SET result_preview_json = #{resultPreviewJson}
        WHERE id = #{id}
    </update>

</mapper>
