<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  PerfRunTaskMapper XML (只读).

  V1.0 仅暴露读方法：selectById / selectByTaskNo / selectByCondition / countByCondition / countByTypeAndDate。
  写入由 V1.1 计算引擎模块提供。

  安全 (SQL 注入) 声明:
    selectByCondition / countByCondition 中的 ${dataScopeFilter} 为 common-dev-guide §5 允许的
    合法数据范围 SQL 片段注入；调用方必须保证该参数由 common-security DataScopeApi 可信生成，
    禁止接收任何用户输入直接拼入。其他参数一律使用 #{} 预编译占位符。
-->
<mapper namespace="com.bank.branch.platform.performance.mapper.PerfRunTaskMapper">

    <sql id="BASE_COLUMNS">
        id, task_type, trigger_type, task_key, data_date, data_version, params_json,
        status, started_by, start_time, end_time, error_msg, result_preview_json, created_time
    </sql>

    <!-- selectById 由 MyBatis-Plus BaseMapper 提供 -->

    <!--
        V1.0 语义：task_key 既承担 "关键键"（如 metric_code），也承担 "任务编号"。
        V1.1 若 DDL 新增独立 task_no 列，仅需改本处底层列名，接口保持不变。
    -->
    <select id="selectByTaskNo" resultType="com.bank.branch.platform.performance.entity.PerfRunTask">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM PERF_RUN_TASK
        WHERE task_key = #{taskNo}
        LIMIT 1
    </select>

    <!--
        V1.13 起过滤条件收敛到 RunTaskQuery (q.*)，新增 triggerType/startedBy/dataDateFrom/dataDateTo。
    -->
    <sql id="CONDITION_WHERE">
        <if test="q.taskType != null and q.taskType != ''">
            AND task_type = #{q.taskType}
        </if>
        <if test="q.triggerType != null and q.triggerType != ''">
            AND trigger_type = #{q.triggerType}
        </if>
        <if test="q.taskKey != null and q.taskKey != ''">
            AND task_key = #{q.taskKey}
        </if>
        <if test="q.status != null and q.status != ''">
            AND status = #{q.status}
        </if>
        <if test="q.startedBy != null and q.startedBy != ''">
            AND started_by = #{q.startedBy}
        </if>
        <if test="q.dataDate != null">
            AND data_date = #{q.dataDate}
        </if>
        <if test="q.dataDateFrom != null">
            AND data_date &gt;= #{q.dataDateFrom}
        </if>
        <if test="q.dataDateTo != null">
            AND data_date &lt;= #{q.dataDateTo}
        </if>
        <!--
            数据范围 SQL 片段注入 (合法 ${}):
            - null / 空串 -> 管理员全见
            - 非空 -> 由 DataScopeApi 生成形如 " AND started_by = 'xxx' "
            调用方必须保证来源可信, 见 Mapper Javadoc 的安全声明.
        -->
        <if test="dataScopeFilter != null and dataScopeFilter != ''">
            ${dataScopeFilter}
        </if>
    </sql>

    <select id="selectByCondition" resultType="com.bank.branch.platform.performance.entity.PerfRunTask">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM PERF_RUN_TASK
        <where>
            <include refid="CONDITION_WHERE"/>
        </where>
        ORDER BY start_time DESC, id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countByCondition" resultType="long">
        SELECT COUNT(*)
        FROM PERF_RUN_TASK
        <where>
            <include refid="CONDITION_WHERE"/>
        </where>
    </select>

    <select id="countByTypeAndDate" resultType="long">
        SELECT COUNT(*)
        FROM PERF_RUN_TASK
        WHERE task_type = #{taskType}
          AND data_date = #{dataDate}
    </select>

    <!--
        V1.1 Task P2.4 起扩展写方法：由计算引擎写入任务记录.
        注意：created_time 由 DB 默认值 CURRENT_TIMESTAMP 填充；start_time 由代码显式传入。
    -->
    <!-- insert 由 MyBatis-Plus BaseMapper 提供 -->

    <!--
        状态机：PENDING -> RUNNING -> SUCCESS/FAILED/PARTIAL/PARTIAL_FAILED/CANCELLED.
        当 status 为终态（SUCCESS/FAILED/PARTIAL/PARTIAL_FAILED/CANCELLED）时，end_time 自动设为 NOW()；
        RUNNING 状态时 end_time 清空。
        errorMsg 为 null 时清空 error_msg 列（业务语义：重试成功时抹去上一次错误信息）。
    -->
    <update id="updateStatus">
        UPDATE PERF_RUN_TASK
        SET status = #{status},
            error_msg = #{errorMsg},
            end_time = <choose>
                <when test="status == 'SUCCESS' or status == 'FAILED' or status == 'PARTIAL' or status == 'PARTIAL_FAILED' or status == 'CANCELLED'">
                    NOW()
                </when>
                <otherwise>
                    NULL
                </otherwise>
            </choose>
        WHERE id = #{id}
    </update>

    <!--
        V1.1 P8 Task C.1：单列更新 result_preview_json，不触碰 status/end_time/error_msg.
        由 HistoryRecalcService 写入 childTaskIds JSON 数组。
    -->
    <update id="updateResultPreviewJson">
        UPDATE PERF_RUN_TASK
        SET result_preview_json = #{resultPreviewJson}
        WHERE id = #{id}
    </update>

    <!--
        V1.7：updateStatus + 同步写 params_json（多主体计算终态专用）.
        end_time 固定写 NOW()，因本方法只在终态（SUCCESS/PARTIAL_FAILED/FAILED）调用。
    -->
    <update id="updateStatusWithParams">
        UPDATE PERF_RUN_TASK
           SET status    = #{status},
               error_msg = #{errorMsg},
               params_json = #{paramsJson},
               end_time  = NOW()
         WHERE id = #{id}
    </update>

    <!--
        V1.2 Task Q5.2：清理 cutoff 之前全部 SUCCESS 状态任务.
        FAILED / RUNNING / PENDING / PARTIAL / CANCELLED 保留；
        RUNNING 任务 end_time 为 NULL 天然不会命中，SUCCESS 终态必然有 end_time.
    -->
    <delete id="deleteSuccessTasksBefore">
        DELETE FROM PERF_RUN_TASK
        WHERE status = 'SUCCESS'
          AND end_time &lt; #{cutoffTime}
    </delete>

</mapper>
