<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  统计展示表 T-1 归档 SQL。目标表、tmp 表名均来自固定白名单和固定后缀，使用 ${} 拼接；
  STATIS_DT 使用 #{}。归档任务直接按运行日和 T-1 操作，不做边界预查询。
-->
<mapper namespace="com.bank.branch.platform.performance.mapper.StatShowArchiveMapper">

    <delete id="truncateTable">
        TRUNCATE TABLE ${table}
    </delete>

    <delete id="deleteByTableDate">
        DELETE FROM ${table} WHERE STATIS_DT = #{dt}
    </delete>

    <select id="countByTableDate" resultType="long">
        SELECT COUNT(*) FROM ${table} WHERE STATIS_DT = #{dt}
    </select>

    <insert id="insertFromTmpByDate">
        INSERT INTO ${targetTable}
        SELECT * FROM ${tmpTable}
        WHERE STATIS_DT = #{dt}
    </insert>

</mapper>
