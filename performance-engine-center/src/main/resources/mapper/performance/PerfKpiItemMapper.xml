<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bank.branch.platform.performance.mapper.PerfKpiItemMapper">

    <sql id="BASE_COLUMNS">
        id, scheme_id, metric_code, base_dim, weight, multiplier, min_score, max_score, formula, sql_expr, created_time
    </sql>

    <!-- insert 由 MyBatis-Plus BaseMapper 提供 -->

    <insert id="insertBatch">
        INSERT INTO PERF_KPI_ITEM (
            <include refid="BASE_COLUMNS"/>
        ) VALUES
        <foreach collection="list" item="item" separator=",">
            (
                #{item.id}, #{item.schemeId}, #{item.metricCode}, #{item.baseDim}, #{item.weight}, #{item.multiplier},
                #{item.minScore}, #{item.maxScore}, #{item.formula}, #{item.sqlExpr}, #{item.createdTime}
            )
        </foreach>
    </insert>

    <update id="updateByIdSelective" parameterType="com.bank.branch.platform.performance.entity.PerfKpiItem">
        UPDATE PERF_KPI_ITEM
        <set>
            <if test="schemeId != null">scheme_id = #{schemeId},</if>
            <if test="metricCode != null">metric_code = #{metricCode},</if>
            <if test="weight != null">weight = #{weight},</if>
            <if test="multiplier != null">multiplier = #{multiplier},</if>
            <if test="minScore != null">min_score = #{minScore},</if>
            <if test="maxScore != null">max_score = #{maxScore},</if>
            <if test="formula != null">formula = #{formula},</if>
            <if test="sqlExpr != null">sql_expr = #{sqlExpr},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- deleteById 由 MyBatis-Plus BaseMapper 提供 -->

    <delete id="deleteBySchemeId">
        DELETE FROM PERF_KPI_ITEM
        WHERE scheme_id = #{schemeId}
    </delete>

    <!-- selectById 由 MyBatis-Plus BaseMapper 提供 -->

    <select id="selectBySchemeId" resultType="com.bank.branch.platform.performance.entity.PerfKpiItem">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM PERF_KPI_ITEM
        WHERE scheme_id = #{schemeId}
        ORDER BY created_time ASC, id ASC
    </select>

    <select id="selectBySchemeAndMetric" resultType="com.bank.branch.platform.performance.entity.PerfKpiItem">
        SELECT
            <include refid="BASE_COLUMNS"/>
        FROM PERF_KPI_ITEM
        WHERE scheme_id = #{schemeId}
          AND metric_code = #{metricCode}
        LIMIT 1
    </select>

    <!-- V1.7：反查依赖某指标的 ACTIVE KPI 方案 ID 列表（供 KpiCascadeListener 使用） -->
    <select id="selectActiveSchemeIdsByMetric" parameterType="string" resultType="string">
        SELECT DISTINCT i.scheme_id
        FROM PERF_KPI_ITEM i
        INNER JOIN PERF_KPI_SCHEME s ON i.scheme_id = s.id
        WHERE i.metric_code = #{metricCode}
          AND s.status = 'ACTIVE'
    </select>

    <select id="selectActiveSchemeRefsByMetric" parameterType="string" resultType="java.util.LinkedHashMap">
        SELECT DISTINCT s.scheme_code AS schemeCode, s.scheme_name AS schemeName
        FROM PERF_KPI_ITEM i
        INNER JOIN PERF_KPI_SCHEME s ON i.scheme_id = s.id
        WHERE i.metric_code = #{metricCode}
          AND s.status = 'ACTIVE'
        ORDER BY s.scheme_code
    </select>

</mapper>
