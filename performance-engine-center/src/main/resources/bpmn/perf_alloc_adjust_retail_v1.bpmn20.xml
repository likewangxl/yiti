<?xml version="1.0" encoding="UTF-8"?>
<!--
  2026-05-20 零售分配关系调整审批流程（完整 6 节点 + 1 可选分支）.

  结构与 perf_alloc_adjust_corp_v1 一致，差异：
    - process id / name = retail
    - biz_dept_review 节点候选解析为零售部经办 (R_RETAIL_DEPT / ROLE_CODE RETAIL_DEPT)
    - biz_dept_leader_approve 节点候选解析为零售部负责人 (R_RETAIL_LEAD / ROLE_CODE RETAIL_DEPT_LEADER)
    - 其余节点候选 (branch_approve / finance_review / finance_leader_approve) 与对公相同

  候选差异通过 WF_NODE_CANDIDATE_CONF 表配置 (process_definition_key 不同)，
  BPMN 文件本身无候选硬编码，故两份 BPMN 结构上完全一致.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://www.bank.com/branch/platform/performance">

    <process id="perf_alloc_adjust_retail_v1" name="零售分配关系调整审批" isExecutable="true">
        <extensionElements>
            <flowable:executionListener event="end" delegateExpression="${processCompletedListener}"/>
        </extensionElements>

        <startEvent id="start" name="开始"/>

        <userTask id="branch_approve" name="机构负责人审批">
            <extensionElements>
                <flowable:taskListener event="create" delegateExpression="${taskAssignmentListener}"/>
            </extensionElements>
        </userTask>

        <userTask id="biz_dept_review" name="零售部经办审批">
            <extensionElements>
                <flowable:taskListener event="create" delegateExpression="${taskAssignmentListener}"/>
            </extensionElements>
        </userTask>

        <exclusiveGateway id="gw1_check_owner" name="是否需要原业绩所属人审批"/>

        <userTask id="original_owner_approve" name="原业绩所属人审批"
                  flowable:assignee="${originalOwnerEmpId}">
            <extensionElements>
                <flowable:taskListener event="create" delegateExpression="${taskAssignmentListener}"/>
            </extensionElements>
        </userTask>

        <exclusiveGateway id="gw2_join" name="汇合"/>

        <userTask id="biz_dept_leader_approve" name="零售部负责人审批">
            <extensionElements>
                <flowable:taskListener event="create" delegateExpression="${taskAssignmentListener}"/>
            </extensionElements>
        </userTask>

        <userTask id="finance_review" name="资财部经办审批">
            <extensionElements>
                <flowable:taskListener event="create" delegateExpression="${taskAssignmentListener}"/>
            </extensionElements>
        </userTask>

        <userTask id="finance_leader_approve" name="资财部负责人审批">
            <extensionElements>
                <flowable:taskListener event="create" delegateExpression="${taskAssignmentListener}"/>
            </extensionElements>
        </userTask>

        <endEvent id="end" name="结束"/>

        <sequenceFlow id="flow_start_branch" sourceRef="start" targetRef="branch_approve"/>
        <sequenceFlow id="flow_branch_biz" sourceRef="branch_approve" targetRef="biz_dept_review"/>
        <sequenceFlow id="flow_biz_gw1" sourceRef="biz_dept_review" targetRef="gw1_check_owner"/>

        <sequenceFlow id="flow_gw1_to_owner" sourceRef="gw1_check_owner" targetRef="original_owner_approve">
            <conditionExpression xsi:type="tFormalExpression">${needsOriginalOwnerApprove == true}</conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flow_gw1_to_gw2" sourceRef="gw1_check_owner" targetRef="gw2_join">
            <conditionExpression xsi:type="tFormalExpression">${needsOriginalOwnerApprove != true}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="flow_owner_to_gw2" sourceRef="original_owner_approve" targetRef="gw2_join"/>
        <sequenceFlow id="flow_gw2_to_leader" sourceRef="gw2_join" targetRef="biz_dept_leader_approve"/>
        <sequenceFlow id="flow_leader_finrev" sourceRef="biz_dept_leader_approve" targetRef="finance_review"/>
        <sequenceFlow id="flow_finrev_finldr" sourceRef="finance_review" targetRef="finance_leader_approve"/>
        <sequenceFlow id="flow_finldr_end" sourceRef="finance_leader_approve" targetRef="end"/>
    </process>
</definitions>
