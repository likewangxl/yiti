<?xml version="1.0" encoding="UTF-8"?>
<!--
  零售分配关系调整审批流程（简化版 2026-05-26）.

  流程：
    start
      → biz_dept_review             (零售部经办审批)
          表单字段 routeTo: LEADER / END
      → gw_route                    (排他网关)
          ├─ ${routeTo == 'LEADER'}
          │     → finance_leader_approve  (资财部负责人审批)
          │     → end
          └─ ${routeTo == 'END'}
                → end（直接结束）
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://www.bank.com/branch/platform/performance">

    <process id="perf_alloc_adjust_retail_v1" name="零售分配关系调整审批" isExecutable="true">
        <extensionElements>
            <flowable:executionListener event="end" delegateExpression="${processCompletedListener}"/>
        </extensionElements>

        <startEvent id="start" name="开始"/>

        <userTask id="biz_dept_review" name="零售部经办审批">
            <extensionElements>
                <flowable:taskListener event="create" delegateExpression="${taskAssignmentListener}"/>
            </extensionElements>
        </userTask>

        <exclusiveGateway id="gw_route" name="审批路由"/>

        <userTask id="finance_leader_approve" name="资财部负责人审批">
            <extensionElements>
                <flowable:taskListener event="create" delegateExpression="${taskAssignmentListener}"/>
            </extensionElements>
        </userTask>

        <endEvent id="end" name="结束"/>

        <sequenceFlow id="flow_start" sourceRef="start" targetRef="biz_dept_review"/>
        <sequenceFlow id="flow_review_gw" sourceRef="biz_dept_review" targetRef="gw_route"/>

        <sequenceFlow id="flow_to_leader" sourceRef="gw_route" targetRef="finance_leader_approve">
            <conditionExpression xsi:type="tFormalExpression">${routeTo == 'LEADER'}</conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flow_to_end" sourceRef="gw_route" targetRef="end">
            <conditionExpression xsi:type="tFormalExpression">${routeTo == 'END'}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="flow_leader_end" sourceRef="finance_leader_approve" targetRef="end"/>
    </process>
</definitions>
