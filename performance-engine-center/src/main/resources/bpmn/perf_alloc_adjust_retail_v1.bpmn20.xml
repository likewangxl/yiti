<?xml version="1.0" encoding="UTF-8"?>
<!--
  零售分配关系调整审批流程（2026-05-26 v2）.

  流程：
    start
      → branch_approve              (机构负责人审批，同机构过滤)
      → biz_dept_review             (零售部经办审批，formData.corpRouteTo: LEADER / OWNER)
      → gw1_retail_route            (排他网关)
          ├─ LEADER → biz_dept_leader_approve (零售部负责人审批) → gw1_join
          └─ OWNER  → original_owner_approve  (原业绩所属人审批，并行多实例会签，全部通过后)
                       → biz_dept_leader_approve (零售部负责人审批) → gw1_join
      → gw1_join
      → finance_review              (资财部经办审批，formData.finRouteTo: LEADER / END)
      → gw2_fin_route               (排他网关)
          ├─ LEADER → finance_leader_approve (资财部负责人审批) → end
          └─ END    → end
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://www.bank.com/branch/platform/performance">

    <process id="perf_alloc_adjust_retail_v1" name="零售分配关系调整审批" isExecutable="true">
        <extensionElements>
            <flowable:executionListener event="end" delegateExpression="${processCompletedListener}"/>
        </extensionElements>

        <startEvent id="start" name="开始"/>

        <userTask id="branch_approve" name="机构负责人审批">
            <extensionElements>
                <flowable:taskListener event="create" delegateExpression="${taskAssignmentListener}"/>
            </extensionElements>
        </userTask>

        <userTask id="biz_dept_review" name="零售部经办审批">
            <extensionElements>
                <flowable:taskListener event="create" delegateExpression="${taskAssignmentListener}"/>
            </extensionElements>
        </userTask>

        <exclusiveGateway id="gw1_retail_route" name="零售部路由"/>

        <userTask id="biz_dept_leader_approve" name="零售部负责人审批">
            <extensionElements>
                <flowable:taskListener event="create" delegateExpression="${taskAssignmentListener}"/>
            </extensionElements>
        </userTask>

        <userTask id="original_owner_approve" name="原业绩所属人审批"
                  flowable:assignee="${ownerEmpId}">
            <extensionElements>
                <flowable:taskListener event="create" delegateExpression="${taskAssignmentListener}"/>
            </extensionElements>
            <!-- 与对公线一致：对 originalOwnerEmpIds 并行多实例会签，每个原所属人一个子任务，全部通过后流转 -->
            <multiInstanceLoopCharacteristics isSequential="false"
                    flowable:collection="${originalOwnerEmpIds}" flowable:elementVariable="ownerEmpId">
                <completionCondition>${nrOfCompletedInstances == nrOfInstances}</completionCondition>
            </multiInstanceLoopCharacteristics>
        </userTask>

        <exclusiveGateway id="gw1_join" name="零售部汇合"/>

        <userTask id="finance_review" name="资财部经办审批">
            <extensionElements>
                <flowable:taskListener event="create" delegateExpression="${taskAssignmentListener}"/>
            </extensionElements>
        </userTask>

        <exclusiveGateway id="gw2_fin_route" name="资财部路由"/>

        <userTask id="finance_leader_approve" name="资财部负责人审批">
            <extensionElements>
                <flowable:taskListener event="create" delegateExpression="${taskAssignmentListener}"/>
            </extensionElements>
        </userTask>

        <endEvent id="end" name="结束"/>

        <!-- 主线 -->
        <sequenceFlow id="f_start" sourceRef="start" targetRef="branch_approve"/>
        <sequenceFlow id="f_branch_biz" sourceRef="branch_approve" targetRef="biz_dept_review"/>
        <sequenceFlow id="f_biz_gw1" sourceRef="biz_dept_review" targetRef="gw1_retail_route"/>

        <!-- 零售部网关 -->
        <sequenceFlow id="f_gw1_leader" sourceRef="gw1_retail_route" targetRef="biz_dept_leader_approve">
            <conditionExpression xsi:type="tFormalExpression">${corpRouteTo == 'LEADER'}</conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="f_gw1_owner" sourceRef="gw1_retail_route" targetRef="original_owner_approve">
            <conditionExpression xsi:type="tFormalExpression">${corpRouteTo == 'OWNER'}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="f_leader_join" sourceRef="biz_dept_leader_approve" targetRef="gw1_join"/>
        <!-- 原业绩所属人全部会签通过后，流转到零售部负责人审批（OWNER 路径经零售部负责人再汇合，与对公线一致） -->
        <sequenceFlow id="f_owner_leader" sourceRef="original_owner_approve" targetRef="biz_dept_leader_approve"/>

        <!-- 汇合后进资财部 -->
        <sequenceFlow id="f_join_fin" sourceRef="gw1_join" targetRef="finance_review"/>
        <sequenceFlow id="f_fin_gw2" sourceRef="finance_review" targetRef="gw2_fin_route"/>

        <!-- 资财部网关 -->
        <sequenceFlow id="f_gw2_leader" sourceRef="gw2_fin_route" targetRef="finance_leader_approve">
            <conditionExpression xsi:type="tFormalExpression">${finRouteTo == 'LEADER'}</conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="f_gw2_end" sourceRef="gw2_fin_route" targetRef="end">
            <conditionExpression xsi:type="tFormalExpression">${finRouteTo == 'END'}</conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="f_finldr_end" sourceRef="finance_leader_approve" targetRef="end"/>
    </process>
</definitions>
