<?xml version="1.0" encoding="UTF-8"?>
<!--
  2026-05-22 目标修正审批流程 v20：精简为 1 节点.

  业务规则（新需求）：
    - 仅资财部经办（角色 BACK_FINANCE）可发起目标修正
    - 流程仅需资财部负责人（FINANCE_LEADER）单点审批
    - 通过则后端事件触发写入 PERF_TARGET_VALUE 主表
    - 不通过则申请表 status=REJECTED，主表数值不变

  与上版（6 节点：branch_approve / biz_dept_review / original_owner_approve /
    biz_dept_leader_approve / finance_review / finance_leader_approve）相比，
  本版仅保留 finance_leader_approve 节点（即"资财部负责人审批"）.
  perf_alloc_adjust_corp_v1 / retail_v1 不在本次改动范围.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://www.bank.com/branch/platform/performance">

    <process id="perf_target_adjust_v1" name="目标修正审批" isExecutable="true">
        <extensionElements>
            <flowable:executionListener event="end" delegateExpression="${processCompletedListener}"/>
        </extensionElements>

        <startEvent id="start" name="开始"/>

        <userTask id="finance_leader_approve" name="资财部负责人审批">
            <extensionElements>
                <flowable:taskListener event="create" delegateExpression="${taskAssignmentListener}"/>
            </extensionElements>
        </userTask>

        <endEvent id="end" name="结束"/>

        <sequenceFlow id="flow_start_finldr"  sourceRef="start"                  targetRef="finance_leader_approve"/>
        <sequenceFlow id="flow_finldr_end"    sourceRef="finance_leader_approve" targetRef="end"/>
    </process>
</definitions>
